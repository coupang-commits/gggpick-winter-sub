# Long-cache static assets (top rules win on Cloudflare Pages)
/*.css
  Cache-Control: public, max-age=2592000, immutable
/*.js
  Cache-Control: public, max-age=2592000, immutable
/*.png
  Cache-Control: public, max-age=2592000, immutable
/*.jpg
  Cache-Control: public, max-age=2592000, immutable
/*.webp
  Cache-Control: public, max-age=2592000, immutable
/*.svg
  Cache-Control: public, max-age=2592000, immutable
/*.woff2
  Cache-Control: public, max-age=2592000, immutable

# HTML pages
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
/**/index.html
  Cache-Control: public, max-age=3600, must-revalidate

# Pretty URLs (no /* catch-all — it was merging into CSS responses)
/
  Cache-Control: public, max-age=3600, must-revalidate
/posts/*
  Cache-Control: public, max-age=3600, must-revalidate
/categories/*
  Cache-Control: public, max-age=3600, must-revalidate
/tags/*
  Cache-Control: public, max-age=3600, must-revalidate
/page/*
  Cache-Control: public, max-age=3600, must-revalidate
/v/*
  Cache-Control: public, max-age=3600, must-revalidate
/20*
  Cache-Control: public, max-age=3600, must-revalidate
